# ==== Security ====
SECRET_KEY=change-this-super-secret-key-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==== AI API ====
# Leave blank to run in FALLBACK / DEMO mode (no AI - uses built-in questions + rule-based scoring)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ==== App ====
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_RESUME_SIZE_MB=5

# ==== Database ====
# SQLite is used automatically - no setup needed. Leave this alone unless
# you specifically want to point at a different SQLAlchemy database URL.
DATABASE_URL=sqlite:///./smart_ai_interview.db
